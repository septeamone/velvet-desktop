{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velvet TV",
  "version": "1.0.5",
  "identifier": "com.septeamone.velvetradio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Velvet TV",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPlatformDocumentViewer,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "septeamone",
    "shortDescription": "Российское ТВ и радио в одном приложении",
    "longDescription": "Velvet TV: российские телеканалы с программой передач, выбором качества и картинкой в картинке, плюс радио на 400+ станций из России и 28 стран.",
    "copyright": "© 2026 septeamone",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQTIwMTcwNzdFQTg1OEUKUldTT2hlcDNjQUdpSUpVSHU1VjE3aVoydldJRFdrNWJzNTBjb2E5N2EvZXR0WDBIVG5OazBOSkEK",
      "endpoints": [
        "https://github.com/septeamone/velvet-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "velvet-tv"
}